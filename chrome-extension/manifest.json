{
  "manifest_version": 3,
  "name": "Deep Work Lock",
  "version": "0.2.1",
  "description": "Locks one tab during a Deep Work Lock session (driven by the GNOME extension).",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "nativeMessaging",
    "declarativeNetRequest",
    "webNavigation",
    "storage"
  ]
}
