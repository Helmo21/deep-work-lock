{
  "manifest_version": 3,
  "name": "Deep Work Lock",
  "version": "0.2.0",
  "description": "Verrouille un onglet pendant une session Deep Work Lock (pilotée par l'extension GNOME).",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "nativeMessaging",
    "declarativeNetRequest",
    "webNavigation",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}